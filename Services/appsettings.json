{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "ConnectionStrings": {
    "Invites": ""
  },
  "Invite": {
    "Lifetime": "00:15:00",
    "PinLength": 8,
    "PinAlphabet": "ABCDEFGHJKLMNPQRSTUVWXYZ23456789",
    "ServerSecretSizeBytes": 32,
    "RevokeTokenSizeBytes": 32
  },
  "Lockout": {
    "FirstThreshold": 3,
    "FirstDuration": "00:02:00",
    "SecondThreshold": 5,
    "SecondDuration": "00:05:00"
  },
  "Pow": {
    "BaseDifficulty": 18,
    "MaxDifficulty": 26,
    "ChallengeTtl": "00:02:00",
    "BucketDuration": "00:01:00",
    "SigningKeyBase64": ""
  },
  "Encryption": {
    "KeyBase64": ""
  },
  "Hashing": {
    "KeyBase64": ""
  }
}
